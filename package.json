{
  "name": "danaterbuka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm --filter @danaterbuka/shared build",
    "dev": "pnpm --filter @danaterbuka/shared build && pnpm -r --parallel dev",
    "build": "pnpm --filter @danaterbuka/shared build && pnpm --filter @danaterbuka/api build && pnpm --filter @danaterbuka/web build",
    "start": "node apps/api/dist/index.js",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
