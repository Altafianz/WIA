# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Data adapter: "fixture" or "snapshot"
DATA_ADAPTER=snapshot

# Default region slug
DEFAULT_REGION_SLUG=provinsi-jawa-barat

# Path file penyimpanan kiriman saran (format JSONL, default: data/feedback/feedback.jsonl)
FEEDBACK_FILE=data/feedback/feedback.jsonl

# Webhook URL opsional untuk notifikasi saran baru (kompatibel format Discord {"content": "..."})
FEEDBACK_WEBHOOK_URL=

# Pengaturan trust proxy express untuk reverse proxy di belakang load balancer/CDN (mis. true, 1, atau subnet)
TRUST_PROXY=false

