# Server configuration
# Port HTTP yang didengarkan Express (default: 3001)
PORT=3001
# Host bind; 0.0.0.0 agar dapat dijangkau hosting/container
HOST=0.0.0.0
# Environment runtime: development | test | production
NODE_ENV=development

# Sumber data: "snapshot" (data/processed/snapshot.v1.json) atau "fixture"
DATA_ADAPTER=snapshot

# Region default saat URL tidak menyebutkan region
DEFAULT_REGION_SLUG=provinsi-jawa-barat

# Path file penyimpanan saran (JSONL). Relatif terhadap akar repo,
# atau gunakan path absolut. Default: data/feedback/feedback.jsonl
FEEDBACK_FILE=data/feedback/feedback.jsonl

# Webhook URL opsional untuk notifikasi saran baru (kompatibel Discord {"content": "..."}).
# Biarkan kosong untuk menonaktifkan notifikasi.
FEEDBACK_WEBHOOK_URL=

# Reverse proxy di depan Express: "1" = satu hop proxy, "0"/"false" = tanpa proxy,
# atau nilai Express lain seperti "true" / daftar subnet.
TRUST_PROXY=0
